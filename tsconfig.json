{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "jsx": "preserve",
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "lib": [
      "ESNext"
    ],
    "types": [
      "react-native",
      "jest",
      "node"
    ],
    "moduleResolution": "NodeNext",
    "baseUrl": "./",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
  }
}